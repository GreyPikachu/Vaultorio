[Unit]
Description=Factorio P2P Cloud Sync Safe Hub & STUN Coordinator
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/factorio-hub
ExecStart=/opt/factorio-hub/venv/bin/uvicorn src.server.main:app --host 0.0.0.0 --port 8088 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5

# Environment Configuration
Environment=FACTORIO_STORAGE_DIR=/opt/factorio-hub/data
Environment=FACTORIO_HTTP_PORT=8088
Environment=FACTORIO_UDP_STUN_PORT=14197
Environment=FACTORIO_MAX_BACKUPS=3
Environment=PYTHONUNBUFFERED=1

# Cgroup Resource Isolation (Strict VPN protection limits)
MemoryAccounting=true
MemoryHigh=48M
MemoryMax=64M
CPUQuota=15%

# Security & Sandboxing Policies
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
